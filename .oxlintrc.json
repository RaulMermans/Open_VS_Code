{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schema/src/public/.oxlintrc.schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "typescript/no-base-to-string": "warn",
    "no-control-regex": "off","no-unused-vars": "off","typescript/no-non-null-asserted-optional-chain": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  },
  "ignorePatterns": ["**/node_modules", "**/dist", "**/*.d.ts", "**/fixtures"]
}
