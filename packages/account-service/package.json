{
  "name": "@open-vs-code/account-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "open-vs-code-admin": "./bin/admin.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src tests",
    "test": "node --import tsx/esm --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@open-vs-code/agent-core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/account-client.ts",
      "import": "./src/client/account-client.ts",
      "require": "./src/client/account-client.ts"
    },
    "./package.json": "./package.json"
  }
}
