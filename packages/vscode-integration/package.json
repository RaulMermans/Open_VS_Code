{
  "name": "@open-vs-code/vscode-integration",
  "version": "0.1.0",
  "displayName": "Open VS Code Agent",
  "description": "Minimal integration for Open VS Code agent",
  "engines": {
    "vscode": "^1.90.0"
  },
  "type": "commonjs",
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:open-vs-code.ask",
    "onCommand:open-vs-code.plan",
    "onCommand:open-vs-code.build",
    "onCommand:open-vs-code.debug",
    "onCommand:open-vs-code.review"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "open-vs-code.chat",
          "name": "Open VS Code Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "open-vs-code.ask",
        "title": "Agent: Ask"
      },
      {
        "command": "open-vs-code.plan",
        "title": "Agent: Plan"
      },
      {
        "command": "open-vs-code.build",
        "title": "Agent: Build"
      },
      {
        "command": "open-vs-code.debug",
        "title": "Agent: Debug"
      },
      {
        "command": "open-vs-code.review",
        "title": "Agent: Review"
      },
      {
        "command": "open-vs-code.toggleAutocomplete",
        "title": "Open VS Code: Toggle Autocomplete"
      },
      {
        "command": "open-vs-code.setHaloToken",
        "title": "Open VS Code: Set HALO Application Token"
      },
      {
        "command": "open-vs-code.checkHaloConnection",
        "title": "Open VS Code: Check HALO Connection"
      },
      {
        "command": "open-vs-code.createStarterConfig",
        "title": "Open VS Code: Create Starter Model Configuration"
      },
      {
        "command": "open-vs-code.openModelConfig",
        "title": "Open VS Code: Open Model Configuration"
      }
    ],

    "configuration": {
      "title": "Open VS Code",
      "properties": {
        "open-vs-code.inferenceBackend": {
          "type": "string",
          "enum": ["standalone-local", "halo"],
          "default": "standalone-local",
          "description": "Explicit inference backend. HALO failures never fall back to standalone local inference."
        },
        "open-vs-code.halo.coreUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4310",
          "description": "Local HALO Core URL."
        },
        "open-vs-code.halo.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1,
          "description": "Maximum HALO request duration in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@open-vs-code/agent-core": "*",
    "@open-vs-code/ide-adapter": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.2"
  }
}
