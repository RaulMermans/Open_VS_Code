{
  "name": "open-vs-code",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI coding agent for open-weight models",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "desktop:prepare": "npm --workspace=@open-vs-code/desktop run prepare",
    "desktop:build": "npm --workspace=@open-vs-code/desktop run build",
    "desktop:package": "npm --workspace=@open-vs-code/desktop run package",
    "desktop:smoke": "npm --workspace=@open-vs-code/desktop run smoke",
    "desktop:accept": "npm --workspace=@open-vs-code/desktop run accept",
    "eval:model": "npm --workspace=@open-vs-code/agent-core run eval:model",
    "eval:models": "npm --workspace=@open-vs-code/agent-core run eval:models",
    "eval:coding": "npm --workspace=@open-vs-code/agent-core run eval:coding",
    "eval:runtime": "npm --workspace=@open-vs-code/agent-core run eval:runtime",
    "eval:recovery": "npm --workspace=@open-vs-code/agent-core run eval:recovery",
    "eval:performance": "npm --workspace=@open-vs-code/agent-core run eval:performance",
    "eval:ide-performance": "npm --workspace=@open-vs-code/vscode-integration run eval:performance --",
    "eval:skills": "npm --workspace=@open-vs-code/agent-core run eval:skills",
    "eval:workflow": "npm --workspace=@open-vs-code/agent-core run eval:workflow",
    "eval:progress": "npm --workspace=@open-vs-code/agent-core run eval:progress",
    "eval:learning": "npm --workspace=@open-vs-code/agent-core run eval:learning"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxlint": "^1.80.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
