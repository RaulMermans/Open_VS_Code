{
  "name": "open-vs-code",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI coding agent for open-weight models",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspace=@open-vs-code/agent-core run test",
    "typecheck": "npm --workspace=@open-vs-code/agent-core run typecheck",
    "lint": "npm --workspace=@open-vs-code/agent-core run lint",
    "build": "npm --workspace=@open-vs-code/agent-core run build",
    "eval:model": "npm --workspace=@open-vs-code/agent-core run eval:model",
    "eval:coding": "npm --workspace=@open-vs-code/agent-core run eval:coding"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
