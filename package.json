{
  "name": "open-vs-code",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI coding agent for open-weight models",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "eval:model": "npm --workspace=@open-vs-code/agent-core run eval:model",
    "eval:coding": "npm --workspace=@open-vs-code/agent-core run eval:coding",
    "eval:runtime": "npm --workspace=@open-vs-code/agent-core run eval:runtime"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "oxlint": "^1.80.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
