{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-vs-code.local/schemas/skill.schema.json",
  "title": "Open VS Code SKILL.md frontmatter (Portable Skills Runtime, ADR-029)",
  "description": "Metadata contract for .open-vs-code/skills/<id>/SKILL.md and built-in skills. The runtime validator in packages/agent-core/src/skills/schema.ts is authoritative and is tested against this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "category", "allowed_modes", "capabilities", "required_tools", "context_budget", "risk_level"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 48, "description": "Must equal the skill directory name." },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Shown in the compact metadata index; the only text a selector needs." },
    "version": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "category": { "enum": ["debugging", "testing", "refactoring", "security", "verification", "architecture", "documentation", "design"] },
    "allowed_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ASK", "PLAN", "BUILD", "DEBUG", "REVIEW"] } },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read", "search", "write", "verify", "terminal"] },
      "description": "Declared needs. Checked against the PermissionGate; never granted by the skill."
    },
    "required_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["read_file", "list_directory", "find_files", "search_text", "apply_patch", "create_file", "run_verification"] }
    },
    "context_budget": { "type": "integer", "minimum": 200, "maximum": 4000, "description": "Maximum tokens the injected guidance may occupy." },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "triggers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 '-]*$", "maxLength": 40 }
    },
    "composes_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
      "description": "Explicit composition rule: the only way a second skill may be loaded alongside this one."
    }
  }
}
